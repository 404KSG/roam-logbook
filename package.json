{
  "name": "roam-logbook",
  "version": "0.9.0-beta.56",
  "description": "Single-focus task and time tracking for Roam Research",
  "type": "module",
  "main": "extension.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run verify:workflow && npm run verify:bundle && npm test"
  },
  "keywords": [
    "roam-research",
    "roam-depot",
    "org-mode",
    "task-tracker",
    "logbook",
    "time-tracking"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.20.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1"
  }
}
